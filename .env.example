JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"
NODE_ENV=development
FRONTEND_URL="http://localhost:8080"

# File Upload Limits
MAX_VIDEO_SIZE_MB=500

# Payment fees (charged to customer)
PAYMENT_CONVENIENCE_FEE_PERCENTAGE=2
PAYMENT_TAX_RATE=17.5
PAYMENT_TAX_RATE_KENYA=0

# Currency Exchange Rates (USD to local currency)
# Package prices are stored in USD and converted to local currency during payment
USD_TO_MWK_RATE=1730
USD_TO_KSH_RATE=129

# Package pricing discount per country (1 = full price, 0.5 = 50% off)
MALAWI_PACKAGE_DISCOUNT=0.5
KENYA_PACKAGE_DISCOUNT=1

# Withdrawal fees (deducted from withdrawal amount)
WITHDRAWAL_MOBILE_MONEY_FEE_RATE=0.03
WITHDRAWAL_BANK_FEE_RATE=0.01
WITHDRAWAL_BANK_FIXED_FEE=700

# Paystack (Kenya)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
SYSTEM_SUBACCOUNT_CODE=

# Paychangu (Malawi)
PAYCHANGU_SECRET_KEY=
PAYCHANGU_PUBLIC_KEY=

BACKEND_URL=http://localhost:5000

# Email provider
# hostinger = use SMTP_* settings below
# resend = use RESEND_* settings below
EMAIL_PROVIDER=hostinger
EMAIL_FROM="ICIMS <no-reply@churchcentral.church>"
EMAIL_REPLY_TO="support@churchcentral.church"

# SMTP Configuration (Hostinger)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@churchcentral.church
SMTP_PASS=
SMTP_FROM="ICIMS <support@churchcentral.church>"

# Resend Configuration
RESEND_API_KEY=
RESEND_FROM="ICIMS <no-reply@churchcentral.church>"
RESEND_REPLY_TO="support@churchcentral.church"

PORT=5000
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=icims
