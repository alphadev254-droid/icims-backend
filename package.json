{
  "name": "icims-backend",
  "version": "1.0.0",
  "description": "ICIMS Church Management System — Express API",
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:push": "prisma db push",
    "db:seed": "ts-node prisma/seed.ts",
    "db:seed-roles": "ts-node prisma/seed-roles.ts",
    "seed:packages": "ts-node prisma/seed-packages.ts",
    "seed:admin-profile": "ts-node scripts/seed-admin-profile.ts",
    "backfill:child-ages": "ts-node scripts/backfill-child-ages.ts",
    "backfill:child-users": "ts-node scripts/backfill-child-user-identities.ts",
    "recalculate:attendance": "ts-node scripts/recalculate-attendance-summaries.ts",
    "recalculate:attendance:apply": "ts-node scripts/recalculate-attendance-summaries.ts --apply",
    "users:archive-cancelled-emails": "ts-node scripts/archive-cancelled-user-emails.ts",
    "users:archive-cancelled-emails:apply": "ts-node scripts/archive-cancelled-user-emails.ts --apply",
    "roles:cleanup-legacy": "ts-node scripts/cleanup-legacy-system-roles.ts",
    "roles:cleanup-legacy:apply": "ts-node scripts/cleanup-legacy-system-roles.ts --apply",
    "packages:bundle-backfill": "ts-node scripts/backfill-package-module-bundles.ts",
    "packages:bundle-backfill:apply": "ts-node scripts/backfill-package-module-bundles.ts --apply",
    "giving:merge-duplicates": "ts-node scripts/merge-duplicate-giving-campaigns.ts",
    "giving:merge-duplicates:apply": "ts-node scripts/merge-duplicate-giving-campaigns.ts --apply",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/multer": "^2.0.0",
    "axios": "^1.13.6",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "firebase-admin": "^13.10.0",
    "ioredis": "^5.4.0",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "multer": "^2.1.0",
    "mysql2": "^3.19.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.1",
    "papaparse": "^5.5.3",
    "prom-client": "^15.1.3",
    "puppeteer": "^24.38.0",
    "react-csv": "^2.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/ioredis": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.1",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.11",
    "@types/papaparse": "^5.5.2",
    "@types/react-csv": "^1.1.10",
    "prisma": "^5.22.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2",
    "xlsx": "^0.18.5"
  }
}
