  phone             String?
  email             String?
  address           String?
  facebookUrl       String?
  youtubeUrl        String?
  whatsappNumber    String?

  isPublished       Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  ministryAdmin     User     @relation(fields: [ministryAdminId], references: [id], onDelete: Cascade)

  @@map("church_profiles")
}

model ChurchSermon {
