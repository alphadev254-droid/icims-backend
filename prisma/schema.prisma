generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Permissions (global — seeded once) ────────────────────────────────────────

model Permission {
  id       String   @id @default(cuid())
  name     String   @unique   // e.g. 'members:create'
  resource String             // 'members'
  action   String             // 'create'

  roles    RolePermission[]

  @@map("permissions")
}

// ─── Roles (global — shared across all tenants) ────────────────────────────────

model Role {
  id          String   @id @default(cuid())
  name        String   @unique    // 'national_admin' | 'regional_leader' etc.
  displayName String              // 'National Administrator'
  description String?
  ministryAdminId String?
  isSystemRole Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  permissions RolePermission[]
  scope       RoleScope?
  users       User[]

  @@index([ministryAdminId])
  @@map("roles")
}

model RoleScope {
  id                     String   @id @default(cuid())
  roleId                 String   @unique
  ministryAdminId        String
  scopeType              String   @default("specific_churches")
  churchIds              String?  @db.Text
  regions                String?  @db.Text
  districts              String?  @db.Text
  traditionalAuthorities String?  @db.Text
  createdAt              DateTime @default(now())
  updatedAt              DateTime @default(now()) @updatedAt

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([ministryAdminId])
  @@map("role_scopes")
}

// ─── Role ↔ Permission junction ────────────────────────────────────────────────

model RolePermission {
  ministryAdminId String   @default("GLOBAL")
  roleId          String
  permissionId    String

  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([ministryAdminId, roleId, permissionId])
  @@map("role_permissions")
}

// ─── Users & Auth ─────────────────────────────────────────────────────────────

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("password_reset_tokens")
}

model User {
  id                     String   @id @default(cuid())
  email                  String   @unique
  password               String
  firstName              String
  lastName               String
  roleId                 String?
  phone                  String?
  avatar                 String?
  churchId               String?
  ministryAdminId        String?
  accountCountry         String?  @map("account_country")
  regions                String?  @db.Text
  districts              String?  @db.Text
  traditionalAuthorities String?  @db.Text
  title                  String?  // Rev, Dr, Prof, Pastor, Prophet, Seer, Sister, Brother, Father, Deacon, Apostle, Evangelist, Other
  titleOther             String?  // Custom title when title = 'Other'
  ministryName           String?  // Name of Ministry/Church
  currentMembership      Int?     // Current membership count
  numberOfBranches       Int?     @default(0) // Number of branches
  gender                 String?
  dateOfBirth            DateTime?
  maritalStatus          String?  // Single, Married, Widowed, Divorced
  weddingDate            DateTime?  // Only if married
  anniversary            DateTime?
  residentialNeighbourhood String?
  serviceInterest        String?  // Choir, Ushering, Greeters, Security/Protocol, Missions/Outreaches, Other
  membershipType         String?  // Visitor, Member
  memberType             String   @default("adult") // adult | child
  loginEnabled           Boolean  @default(true)
  baptizedByImmersion    Boolean?
  status                 String   @default("active")
  acceptedTerms          Boolean  @default(false)
  termsAcceptedAt        DateTime?
  termsVersion           String?
  privacyVersion         String?
  termsAcceptedIp        String?
  termsAcceptedUserAgent String?  @db.Text
  subdomain              String?  @unique  // e.g. grace-church (without domain)
  memberId               String?  @unique
  attendanceQrToken      String?  @unique
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  role                   Role?    @relation(fields: [roleId], references: [id])
  church                 Church?  @relation(fields: [churchId], references: [id])
  ownedChurches          Church[] @relation("MinistryAdminChurches")
  createdSubaccounts     Subaccount[] @relation("SubaccountCreator")
  tickets                EventTicket[]
  transactions           Transaction[]
  donationTransactions   DonationTransaction[]
  passwordResetTokens    PasswordResetToken[]
  withdrawalOtps         WithdrawalOtp[]
  teams                  UserTeam[]
  reminders              ReminderCache[]
  announcementViews      AnnouncementView[]
  resourceViews          ResourceView[]
  cellMemberships        CellMember[]
  cellAttendance         CellAttendance[]
  pledges                Pledge[]
  churchProfile         ChurchProfile?
  deviceTokens          DeviceToken[]
  sharedAccessLinks     SharedAccessLink[]
  attendanceParticipants AttendanceParticipant[]
  childGuardianLinks    ChildGuardian[]
  createdChildren       Child[] @relation("ChildCreator")
  childProfile          Child? @relation("ChildUser")
  packageInvoices       PackageInvoice[] @relation("PackageInvoiceMinistryAdmin")
  createdPackageInvoices PackageInvoice[] @relation("PackageInvoiceCreator")
  packageInvoicePayments Payment[] @relation("PackageInvoicePaymentCreator")

  @@index([churchId, roleId, status, createdAt])
  @@index([memberType])
  @@index([loginEnabled])
  @@index([attendanceQrToken])
  @@index([dateOfBirth])
  @@index([weddingDate])
  @@index([anniversary])
  @@map("users")
}

// ─── Church Hierarchy ──────────────────────────────────────────────────────────

model Location {
  id                   Int      @id @default(autoincrement())
  country              String   @default("Malawi")
  region               String
  district             String
  traditionalAuthority String   @map("traditional_authority")
  village              String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("locations")
}

model Church {
  id                   String   @id @default(cuid())
  name                 String
  location             String
  country              String   @default("Malawi")
  region               String?
  district             String?
  traditionalAuthority String?
  village              String?
  address              String?
  phone                String?
  email                String?
  website              String?
  pastorName           String?
  logoUrl              String?
  memberCount          Int      @default(0)
  yearFounded          Int?
  branchCode           String?  @unique
  status               String   @default("active")
  ministryAdminId      String?
  latitude             Float?
  longitude            Float?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  inviteToken   String?  @unique

  ministryAdmin User?          @relation("MinistryAdminChurches", fields: [ministryAdminId], references: [id])
  users         User[]
  events        Event[]
  eventLinks    EventChurch[]
  eventTickets  EventTicket[]
  givingCampaigns GivingCampaign[]
  givingCampaignLinks GivingCampaignChurch[]
  donationTransactions DonationTransaction[]
  attendance    Attendance[]
  attendanceParticipants AttendanceParticipant[]
  meetings      Meeting[]
  announcements Announcement[]
  resources     Resource[]
  transactions  Transaction[]
  subaccount    Subaccount?
  wallet        Wallet?
  kpis          KPI[]
  teams         Team[]
  reminders     ReminderCache[]
  cells         Cell[]
  pledges       Pledge[]
  sharedAccessLinks SharedAccessLink[]
  children      Child[]

  @@index([ministryAdminId, status])
  @@index([status])
  @@map("churches")
}

// ─── Subaccounts ───────────────────────────────────────────────────────────────

model Child {
  id          String   @id @default(cuid())
  userId      String?  @unique
  churchId    String
  firstName   String
  lastName    String
  dateOfBirth DateTime?
  age         Int?
  gender      String?
  phone       String?
  status      String   @default("active")
  notes       String?  @db.Text
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  church      Church          @relation(fields: [churchId], references: [id], onDelete: Cascade)
  user        User?           @relation("ChildUser", fields: [userId], references: [id], onDelete: SetNull)
  createdBy   User?           @relation("ChildCreator", fields: [createdById], references: [id])
  guardians   ChildGuardian[]

  @@index([churchId])
  @@index([userId])
  @@index([status])
  @@index([createdById])
  @@map("children")
}

model ChildGuardian {
  id               String   @id @default(cuid())
  childId          String
  guardianId       String
  relationship     String   @default("guardian")
  isPrimary        Boolean  @default(false)
  canPickup        Boolean  @default(true)
  emergencyContact Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  child            Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  guardian         User     @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([childId, guardianId])
  @@index([guardianId])
  @@index([childId])
  @@map("child_guardians")
}

model Subaccount {
  id               String   @id @default(cuid())
  churchId         String   @unique
  ministryAdminId  String
  subaccountCode   String   @unique
  businessName     String
  settlementBank   String
  accountNumber    String
  percentageCharge Float    @default(0)
  description      String?  @db.Text
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  church           Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  ministryAdmin    User     @relation("SubaccountCreator", fields: [ministryAdminId], references: [id])

  @@map("subaccounts")
}

// ─── Events ────────────────────────────────────────────────────────────────────

model Event {
  id            String   @id @default(cuid())
  title         String
  description   String   @db.Text
  date          DateTime
  endDate       DateTime
  time          String
  location      String
  contactEmail  String?
  contactPhone  String?
  type          String   @default("service")
  status        String   @default("upcoming")
  attendeeCount Int      @default(0)
  // Ticketing fields
  requiresTicket Boolean  @default(false)
  isFree        Boolean  @default(true)
  ticketPrice   Float?
  currency      String?  // 'MWK' | 'KSH'
  totalTickets  Int?
  ticketsSold   Int      @default(0)
  ticketSalesCutoff DateTime?
  allowPublicTicketing Boolean @default(false)
  imageUrl      String?
  churchId      String
  scopeType     String   @default("one_church") // one_church | selected_churches | all_churches
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  church        Church       @relation(fields: [churchId], references: [id])
  linkedChurches EventChurch[]
  tickets       EventTicket[]
  reminders     ReminderCache[]

  @@index([churchId, date])
  @@index([scopeType])
  @@map("events")
}

// ─── Event Tickets ────────────────────────────────────────────────────────────

model EventChurch {
  id        String   @id @default(cuid())
  eventId   String
  churchId  String
  createdAt DateTime @default(now())

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@unique([eventId, churchId])
  @@index([churchId])
  @@map("event_churches")
}

model EventTicket {
  id            String   @id @default(cuid())
  ticketNumber  String   @unique
  eventId       String
  churchId      String?
  userId        String?  // null for guest tickets
  transactionId String?
  status        String   @default("confirmed") // reserved | confirmed | cancelled | used
  isManual      Boolean  @default(false) // true if created manually by admin
  isGuest       Boolean  @default(false)
  guestName     String?
  guestEmail    String?
  guestPhone    String?
  attended      Boolean  @default(false)
  attendedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  event         Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  church        Church?      @relation(fields: [churchId], references: [id], onDelete: SetNull)
  user          User?        @relation(fields: [userId], references: [id])
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  attendanceParticipants AttendanceParticipant[]

  @@index([eventId, userId])
  @@index([churchId])
  @@index([isGuest])
  @@map("event_tickets")
}

// ─── Transactions ─────────────────────────────────────────────────────────────

model Transaction {
  id            String   @id @default(cuid())
  amount        Float
  currency      String   @default("MWK")
  status        String   @default("pending") // pending | completed | failed | refunded
  paymentMethod String   @default("cash") // cash | mobile_money | card | bank_transfer
  reference     String?  @unique
  userId        String?  // null for guest transactions
  churchId      String?
  eventId       String?  // For quick event filtering
  type          String   @default("event_ticket") // event_ticket | donation | subscription
  notes         String?  @db.Text
  isManual      Boolean  @default(false) // true if created manually by admin
  // Paystack details
  channel       String?  // mobile_money | card | bank
  ipAddress     String?
  paidAt        DateTime?
  gatewayPayload String?  @db.LongText
  gatewayResponse String?  @db.LongText
  // Fee breakdown
  baseAmount      Float?   // Original amount (what church gets)
  convenienceFee  Float?   // Gateway processing fee (2% Paychangu, 2.9% Paystack)
  systemFeeAmount Float?   // Platform system fee (17.5% Malawi, 16% Kenya of baseAmount)
  totalAmount     Float?   // baseAmount + convenienceFee + systemFeeAmount (ceil'd)
  ceilRoundingAmount Float? // Extra collected due to Math.ceil rounding — goes to ICIMS
  gatewayCharge   Float?   // Actual charge reported by gateway (Paychangu: charge field, Paystack: fees field)
  systemGatewayFeeRate Float?   // Gateway fee rate used e.g. 0.02 for Malawi, 0.029 for Kenya
  systemFeeRate   Float?   // Platform fee rate used e.g. 0.005 for both
  // Gateway routing
  gateway         String?  // paystack | paychangu
  gatewayCountry  String?  // Kenya | Malawi
  // Subaccount info
  subaccountCode String?
  subaccountName String?
  // Customer info (from payment gateway)
  customerEmail String?
  customerPhone String?
  authorizationCode String?
  cardLast4     String?
  cardBank      String?
  // Guest info (typed by user on frontend)
  isGuest       Boolean  @default(false)
  guestName     String?
  guestEmail    String?
  guestPhone    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User?         @relation(fields: [userId], references: [id])
  church        Church?       @relation(fields: [churchId], references: [id])
  tickets       EventTicket[]

  @@index([userId])
  @@index([churchId])
  @@index([type])
  @@index([eventId])
  @@index([status])
  @@index([paidAt])
  @@index([customerEmail])
  @@map("transactions")
}

// ─── Pending Transactions (temporary until payment confirmed) ────────────────

model PendingTransaction {
  id        String   @id @default(cuid())
  reference String?  @unique
  amount    Float
  currency  String   @default("MWK")
  status    String   @default("pending") // pending | completed | failed | abandoned
  userId    String?
  churchId  String
  eventId   String?
  type      String   @default("event_ticket")
  metadata  String?  @db.Text
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([churchId])
  @@index([eventId])
  @@index([status])
  @@index([expiresAt])
  @@index([reference])
  @@map("pending_transactions")
}

// ─── Giving & Donations ────────────────────────────────────────────────────────

model GivingCampaign {
  id            String   @id @default(cuid())
  churchId      String
  scopeType     String   @default("one_church") // one_church | selected_churches | all_churches
  name          String
  description   String?  @db.Text
  category      String   // tithe | offering | partnership | welfare | missions | fellowship_offering
  subcategory   String?  // tv_sponsorship | radio_sponsorship | funeral | wedding | etc
  targetAmount  Float?
  currency      String   @default("MWK")
  status        String   @default("active") // active | completed | cancelled
  startDate     DateTime @default(now())
  endDate       DateTime?
  imageUrl      String?
  allowPublicDonations Boolean @default(false)
  allowPledging        Boolean @default(false)
  cellId        String?  // set when category = fellowship_offering
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  church        Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  cell          Cell?    @relation(fields: [cellId], references: [id])
  linkedChurches GivingCampaignChurch[]
  donations     DonationTransaction[]
  pledges       Pledge[]

  @@index([churchId])
  @@index([scopeType])
  @@index([category])
  @@index([status])
  @@map("giving_campaigns")
}

model GivingCampaignChurch {
  id         String   @id @default(cuid())
  campaignId String
  churchId   String
  createdAt  DateTime @default(now())

  campaign GivingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  church   Church         @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@unique([campaignId, churchId])
  @@index([churchId])
  @@map("giving_campaign_churches")
}

model DonationTransaction {
  id            String   @id @default(cuid())
  campaignId    String
  userId        String?
  churchId      String
  amount        Float
  currency      String   @default("MWK")
  transactionId String?
  paymentMethod String?  // mpesa | card | bank_transfer | cash
  reference     String?
  status        String   @default("pending") // pending | completed | failed
  isAnonymous   Boolean  @default(false)
  isGuest       Boolean  @default(false)
  guestName     String?
  guestEmail    String?
  guestPhone    String?
  donorName     String?
  donorEmail    String?
  donorPhone    String?
  notes         String?  @db.Text
  cellId        String?  // set when campaign category = fellowship_offering
  pledgeId      String?  // links this payment to a pledge
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  campaign      GivingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user          User?    @relation(fields: [userId], references: [id])
  church        Church   @relation(fields: [churchId], references: [id])
  cell          Cell?    @relation(fields: [cellId], references: [id])
  pledge        Pledge?  @relation(fields: [pledgeId], references: [id])

  @@index([campaignId])
  @@index([userId])
  @@index([churchId])
  @@index([transactionId])
  @@index([reference])
  @@index([status])
  @@index([churchId, status, createdAt])
  @@index([pledgeId, status, createdAt])
  @@map("donation_transactions")
}

// ─── Pledges ──────────────────────────────────────────────────────────────────

model Pledge {
  id                  String   @id @default(cuid())
  campaignId          String
  churchId            String
  userId              String?  // null = walk-in pledger recorded by admin
  pledgerName         String?  // for non-member pledgers
  pledgerEmail        String?
  pledgerPhone        String?
  pledgedAmount       Float
  currency            String   @default("MWK")
  amountPaid          Float    @default(0)  // cached sum of linked payments
  // status: pending | partial | fulfilled | overdue
  status              String   @default("pending")
  fulfillmentDeadline DateTime?
  notes               String?  @db.Text
  createdById         String   // userId of who recorded it (admin or self)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  campaign    GivingCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  church      Church               @relation(fields: [churchId], references: [id], onDelete: Cascade)
  user        User?                @relation(fields: [userId], references: [id])
  payments    DonationTransaction[]

  @@index([campaignId])
  @@index([userId])
  @@index([churchId])
  @@index([status])
  @@index([churchId, status])
  @@index([userId, status, createdAt])
  @@index([churchId, createdAt])
  @@index([churchId, status, createdAt])
  @@index([churchId, fulfillmentDeadline])
  @@index([campaignId, churchId, status])
  @@map("pledges")
}

// ─── Attendance ────────────────────────────────────────────────────────────────

model Attendance {
  id             String   @id @default(cuid())
  eventId        String?
  churchId       String
  date           DateTime
  totalAttendees Int
  maleCount      Int      @default(0)
  femaleCount    Int      @default(0)
  children       Int      @default(0)  // 0-12 years
  youth          Int      @default(0)  // 13-17 years
  youngAdults    Int      @default(0)  // 18-35 years
  adults         Int      @default(0)  // 36-59 years
  seniors        Int      @default(0)  // 60+ years
  newVisitors    Int      @default(0)
  serviceType    String   @default("Sunday Service")
  sharedAccessLinkId String?
  notes              String?  @db.Text
  createdAt          DateTime @default(now())
  digitalCheckInEnabled Boolean @default(false)
  qrToken                String?  @unique
  qrStatus               String   @default("draft")
  qrActiveFrom           DateTime?
  qrActiveUntil          DateTime?
  qrRegeneratedAt        DateTime?

  church            Church              @relation(fields: [churchId], references: [id])
  sharedAccessLink  SharedAccessLink?   @relation(fields: [sharedAccessLinkId], references: [id], onDelete: SetNull)
  visitors          AttendanceVisitor[]
  participants      AttendanceParticipant[]

  @@index([churchId, date])
  @@index([sharedAccessLinkId])
  @@index([qrStatus])
  @@map("attendance")
}

model AttendanceParticipant {
  id             String   @id @default(cuid())
  attendanceId   String
  sourceChurchId String?
  eventTicketId  String?  @unique
  userId         String?
  guestName      String?
  guestEmail     String?
  guestPhone     String?
  guestGender    String?
  guestAgeBracket String?
  guestFirstTime Boolean  @default(false)
  invitedBy      String?
  checkInMethod  String   @default("qr_guest")
  status         String   @default("present")
  checkedInAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  sourceChurch Church?   @relation(fields: [sourceChurchId], references: [id], onDelete: SetNull)
  eventTicket EventTicket? @relation(fields: [eventTicketId], references: [id], onDelete: SetNull)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([attendanceId, userId])
  @@index([attendanceId])
  @@index([sourceChurchId])
  @@index([userId])
  @@index([guestPhone])
  @@index([guestGender])
  @@index([guestAgeBracket])
  @@map("attendance_participants")
}

model AttendanceVisitor {
  id              String   @id @default(cuid())
  attendanceId    String
  name            String
  phone           String?
  email           String?
  residentialArea String?
  gender          String?  // male | female | other
  ageBracket      String?  // 0-12 | 13-17 | 18-35 | 36-59 | 60+
  howHeard        String?  // invited_by_friend | street_outreach | social_media | tv_program | radio | website | other
  notes           String?
  createdAt       DateTime @default(now())

  attendance  Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@index([attendanceId])
  @@map("attendance_visitors")
}

// ─── Shared Access Links ──────────────────────────────────────────────────────────

model SharedAccessLink {
  id          String   @id @default(cuid())
  token       String   @unique                      // Short random hash for URL lookup
  type        String   @default("attendance")       // "attendance" — extensible for future types
  churchId    String                                 // Scoped to a specific church
  serviceType String?  @default("Sunday Service")   // Pre-selected service type for the form
  eventId     String?                                // Optional — for event-specific attendance
  accessCode  String?                                // bcrypt hash of the 4-digit access code (optional)

  // Time window
  validFrom   DateTime @default(now())              // Link becomes active at this time
  expiresAt   DateTime                               // Link expires at this time

  // Usage controls
  isActive    Boolean  @default(true)
  useCount    Int      @default(0)
  usageLimit  Int?                                   // Null = unlimited, e.g. 1 = one-time use
  lastUsedAt  DateTime?

  // Audit
  createdBy   String                                 // userId of the admin who created it
  createdAt   DateTime @default(now())

  // Relations
  church      Church           @relation(fields: [churchId], references: [id])
  creator     User             @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  attendance  Attendance[]

  @@index([token])
  @@index([churchId])
  @@index([createdBy])
  @@map("shared_access_links")
}

// ─── Meetings ──────────────────────────────────────────────────────────────────

model Meeting {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  date        DateTime
  time        String
  location    String?
  // status: scheduled | in_progress | completed | cancelled
  status      String   @default("scheduled")
  agenda      String?  @db.Text  // JSON string
  minutes     String?  @db.Text
  churchId    String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  church      Church   @relation(fields: [churchId], references: [id])

  @@map("meetings")
}

// ─── Announcements / Communication ────────────────────────────────────────────

model Announcement {
  id          String   @id @default(cuid())
  title       String
  content     String   @db.Text
  // type: announcement | prayer_request | newsletter
  type        String   @default("announcement")
  // priority: normal | urgent
  priority    String   @default("normal")
  attachments String?  @db.Text  // JSON array of { url, name, size, mimeType }
  churchId    String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  church      Church   @relation(fields: [churchId], references: [id])
  views       AnnouncementView[]

  @@map("announcements")
}

// ─── Resources ────────────────────────────────────────────────────────────────

model Resource {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  // category: bible | devotional | study_plan | sermon | worship | general
  category    String   @default("general")
  // type: article | video | audio | document | link
  type        String   @default("document")
  fileUrl     String?  // primary uploaded file path or external URL
  fileName    String?  // original file name
  fileSize    Int?     // bytes
  mimeType    String?  // e.g. application/pdf
  filesJson   String?  @db.Text  // JSON array of { url, name, size, mimeType } for multiple uploads
  duration    String?  // e.g. "45 min"
  author      String?
  tags        String?  @db.Text  // JSON array
  churchId    String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  church      Church   @relation(fields: [churchId], references: [id])
  views       ResourceView[]

  @@map("resources")
}

// ─── Packages & Payments ───────────────────────────────────────────────────────

model Subscription {
  id              String   @id @default(cuid())
  ministryAdminId String   @unique
  packageId       String
  status          String   @default("active") // active | expired | cancelled
  startsAt        DateTime
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  // Email tracking for expiration reminders
  lastEmailDay    Int?     // Last day email was sent: -6, -4, -2 for expiring; 1-6 for expired

  package         Package  @relation(fields: [packageId], references: [id])

  @@index([ministryAdminId])
  @@index([status])
  @@index([expiresAt])
  @@map("subscriptions")
}

model Package {
  id           String   @id @default(cuid())
  name         String   @unique  // 'basic' | 'standard' | 'premium'
  displayName  String
  description  String?  @db.Text
  priceMonthly Float    @default(0)
  priceYearly  Float    @default(0)
  isActive     Boolean  @default(true)
  isPrivate    Boolean  @default(false) // private packages hidden from public listing
  sortOrder    Int      @default(0)
  // Hard limits enforced at application layer
  maxChurches  Int?     // null = unlimited
  maxMembers   Int?
  maxEvents    Int?
  maxGivings   Int?     // max giving campaigns
  maxCells     Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  features     PackageFeatureLink[]
  payments     Payment[]
  subscriptions Subscription[]
  invoices      PackageInvoice[]

  @@map("packages")
}

model PackageFeature {
  id          String   @id @default(cuid())
  name        String   @unique  // e.g. 'members_management'
  displayName String             // e.g. 'Members Management'
  description String?  @db.Text
  // category: core | communication | reporting | management
  category    String   @default("core")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  packages  PackageFeatureLink[]

  @@map("package_features")
}

model PackageFeatureLink {
  packageId String
  featureId String
  limitValue Int?  // For features like max_members, max_churches

  package Package        @relation(fields: [packageId], references: [id], onDelete: Cascade)
  feature PackageFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([packageId, featureId])
  @@map("package_feature_links")
}

model Payment {
  id              String   @id @default(cuid())
  ministryAdminId String
  packageId       String?
  invoiceId       String?
  amount          Float
  currency        String   @default("MWK")
  // type: subscription | upgrade | downgrade | renewal | package_subscription
  type            String   @default("subscription")
  // status: pending | completed | failed
  status          String   @default("pending")
  // denormalized package name for historical records
  packageName     String   @default("basic")
  reference       String?
  notes           String?  @db.Text
  // Transaction details
  transactionId   String?  // Link to Transaction record
  paymentMethod   String?  // card | mobile_money | bank
  channel         String?  // Paystack channel used
  paidAt          DateTime?
  // Fee breakdown
  baseAmount      Float?   // Original package price
  convenienceFee  Float?   // 2% convenience fee
  systemFeeAmount Float?   // Platform system fee on convenience fee
  totalAmount     Float?   // baseAmount + convenienceFee + systemFeeAmount (ceil'd)
  ceilRoundingAmount Float? // Extra collected due to Math.ceil rounding — goes to ICIMS
  gatewayCharge   Float?   // Actual charge reported by gateway
  systemGatewayFeeRate Float?  // Gateway fee rate used e.g. 0.02 Malawi, 0.029 Kenya
  systemFeeRate   Float?   // Platform fee rate used e.g. 0.005
  // Gateway routing
  gateway         String?  // paystack | paychangu
  // Subaccount info
  subaccountCode  String?  // Subaccount code used
  subaccountName  String?  // Subaccount name
  // Customer info
  customerEmail   String?
  customerPhone   String?
  cardLast4       String?
  cardBank        String?
  // Metadata
  billingCycle    String?  // monthly | yearly
  expiresAt       DateTime? // When this subscription expires
  gatewayPayload  String?  @db.LongText // Full outbound gateway initialization payload
  gatewayResponse String?  @db.LongText // Full Paystack response JSON
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  package         Package? @relation(fields: [packageId], references: [id])
  invoice         PackageInvoice? @relation(fields: [invoiceId], references: [id])
  createdBy       User? @relation("PackageInvoicePaymentCreator", fields: [createdById], references: [id])

  @@index([ministryAdminId])
  @@index([invoiceId])
  @@index([status])
  @@index([paidAt])
  @@index([reference])
  @@index([expiresAt])
  @@map("payments")
}

model PackageInvoice {
  id                 String   @id @default(cuid())
  invoiceNumber      String   @unique
  ministryAdminId    String
  packageId          String
  packageName        String
  billingCycle       String   @default("monthly") // monthly | yearly | custom
  currency           String   @default("MWK")
  amount             Float
  amountPaid         Float    @default(0)
  balanceDue         Float    @default(0)
  status             String   @default("draft") // draft | sent | partially_paid | paid | overdue | cancelled
  publicToken        String?  @unique
  invoiceDate        DateTime @default(now())
  dueDate            DateTime
  servicePeriodStart DateTime
  servicePeriodEnd   DateTime
  lineItems          String?  @db.LongText
  notes              String?  @db.Text
  terms              String?  @db.Text
  sentAt             DateTime?
  paidAt             DateTime?
  lastReminderAt     DateTime?
  createdById        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  ministryAdmin User    @relation("PackageInvoiceMinistryAdmin", fields: [ministryAdminId], references: [id])
  package       Package @relation(fields: [packageId], references: [id])
  createdBy     User?   @relation("PackageInvoiceCreator", fields: [createdById], references: [id])
  payments      Payment[]

  @@index([ministryAdminId, status])
  @@index([packageId])
  @@index([publicToken])
  @@index([dueDate])
  @@index([servicePeriodStart, servicePeriodEnd])
  @@map("package_invoices")
}


// ─── Wallet System (Malawi only) ──────────────────────────────────────────────

model Wallet {
  id              String   @id @default(cuid())
  churchId        String   @unique
  ministryAdminId String
  balance         Float    @default(0)
  currency        String   @default("MWK")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  church          Church   @relation(fields: [churchId], references: [id])
  transactions    WalletTransaction[]
  withdrawals     Withdrawal[]

  @@map("wallets")
}

model WalletTransaction {
  id              String   @id @default(cuid())
  walletId        String
  type            String   // credit | debit
  amount          Float
  balanceBefore   Float
  balanceAfter    Float
  source          String   // event_ticket | donation | withdrawal | refund
  sourceId        String?
  description     String?
  createdAt       DateTime @default(now())

  wallet          Wallet   @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@index([createdAt])
  @@map("wallet_transactions")
}

model Withdrawal {
  id              String   @id @default(cuid())
  walletId        String
  ministryAdminId String
  initiatedBy     String?  // User who initiated the withdrawal
  amount          Float
  fee             Float
  gatewayFeeAmount Float   @default(0)
  gatewayFeeRate   Float?
  bankFixedFeeAmount Float @default(0)
  systemFeeAmount  Float   @default(0)
  systemFeeRate    Float?
  netAmount       Float
  payoutAmount    Float   @default(0)
  method          String   // mobile_money | bank_transfer
  status          String   @default("pending") // pending | processing | completed | failed
  mobileOperator  String?
  mobileNumber    String?
  bankCode        String?
  accountName     String?
  accountNumber   String?
  chargeId        String?  @unique
  gatewayPayload  String?  @db.LongText
  gatewayResponse String?  @db.LongText
  failureReason   String?  @db.Text
  processedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  wallet          Wallet   @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@index([status])
  @@index([createdAt])
  @@map("withdrawals")
}

// ─── KPIs ──────────────────────────────────────────────────────────────────────

model WithdrawalOtp {
  id          String    @id @default(cuid())
  userId      String
  otpHash     String
  payloadHash String
  expiresAt   DateTime
  usedAt      DateTime?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([payloadHash])
  @@map("withdrawal_otps")
}

model PlatformWithdrawal {
  id                 String   @id @default(cuid())
  initiatedBy        String
  approvedBy         String?
  amount             Float
  fee                Float
  gatewayFeeAmount   Float   @default(0)
  gatewayFeeRate     Float?
  bankFixedFeeAmount Float   @default(0)
  netAmount          Float
  payoutAmount       Float   @default(0)
  method             String
  status             String   @default("pending")
  mobileOperator     String?
  mobileNumber       String?
  bankCode           String?
  accountName        String?
  accountNumber      String?
  chargeId           String?  @unique
  gatewayPayload     String?  @db.LongText
  gatewayResponse    String?  @db.LongText
  failureReason      String?  @db.Text
  processedAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([initiatedBy])
  @@index([status])
  @@index([createdAt])
  @@map("platform_withdrawals")
}

model PlatformWithdrawalOtp {
  id          String    @id @default(cuid())
  userId      String
  otpHash     String
  payloadHash String
  expiresAt   DateTime
  usedAt      DateTime?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, expiresAt])
  @@index([payloadHash])
  @@map("platform_withdrawal_otps")
}

model KPI {
  id              String   @id @default(cuid())
  name            String
  description     String?  @db.Text
  category        String   // Attendance | Giving | Membership | Events
  metricType      String   // total_attendance | average_attendance | total_giving | new_members | event_count
  attendanceType  String?  // regular | event (for Attendance category)
  eventId         String?  // Specific event ID (for event attendance KPIs)
  targetValue     Float
  currentValue    Float    @default(0)
  unit            String   // people | MWK | percentage | events
  period          String   // monthly | quarterly | yearly
  startDate       DateTime
  endDate         DateTime
  status          String   @default("active") // active | completed | cancelled
  isRecurring     Boolean  @default(false)
  recurringActive Boolean  @default(true)
  parentKpiId     String?
  recurrenceCount Int      @default(0)
  ministryAdminId String
  churchId        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  church          Church   @relation(fields: [churchId], references: [id])

  @@index([ministryAdminId])
  @@index([churchId])
  @@index([category])
  @@index([status])
  @@index([churchId, status, metricType])
  @@index([parentKpiId])
  @@index([isRecurring, recurringActive, endDate])
  @@map("kpis")
}

// ─── Teams ─────────────────────────────────────────────────────────────────────

model Team {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  churchId    String
  color       String?  // For visual distinction
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  church      Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  members     UserTeam[]
  communications TeamCommunication[]

  @@index([churchId])
  @@map("teams")
}

model UserTeam {
  userId    String
  teamId    String
  isLeader  Boolean  @default(false)
  assignedAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([userId, teamId])
  @@index([teamId])
  @@index([userId])
  @@map("user_teams")
}

// ─── Team Communication ────────────────────────────────────────────────────────

model TeamCommunication {
  id          String   @id @default(cuid())
  title       String
  content     String   @db.Text
  teamId      String
  authorId    String
  mediaUrls   Json?    // [{url, type, name, size}]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([authorId])
  @@index([teamId, createdAt])
  @@map("team_communications")
}

// ─── Email Queue ───────────────────────────────────────────────────────────────

model EmailQueue {
  id          String   @id @default(cuid())
  to          String
  subject     String
  html        String   @db.Text
  attachments String?  @db.LongText // JSON array of {filename, content(base64)}
  type        String   // user_created | registration | password_reset | password_changed | ticket_purchase | donation_receipt
  status      String   @default("pending") // pending | sent | failed
  attempts    Int      @default(0)
  error       String?  @db.Text
  sentAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([status])
  @@index([createdAt])
  @@map("email_queue")
}

// ─── Reminder Cache ────────────────────────────────────────────────────────────

model ReminderCache {
  id              String   @id @default(cuid())
  userId          String
  type            String   // birthday | wedding | member_anniversary | church_founded | event
  originalDate    DateTime
  upcomingDate    DateTime
  daysUntil       Int
  age             Int?
  years           Int?
  churchId        String
  ministryAdminId String?
  eventId         String?  // For event reminders
  eventTitle      String?  // Denormalized for quick display
  lastNotified    DateTime?
  notifyAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  church          Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  event           Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, type, upcomingDate, eventId])
  @@index([upcomingDate])
  @@index([churchId])
  @@index([ministryAdminId])
  @@index([type])
  @@index([notifyAt])
  @@index([daysUntil])
  @@index([eventId])
  @@map("reminder_cache")
}

// ─── Content Views ─────────────────────────────────────────────────────────────

model ScheduledReminder {
  id              String   @id @default(cuid())
  ministryAdminId String?
  churchId        String
  campaignId      String?
  eventId         String?
  type            String
  audience        String
  channelEmail    Boolean  @default(true)
  channelPush     Boolean  @default(true)
  title           String
  message         String   @db.Text
  scheduleKind    String
  scheduleDays    String?  @db.Text
  deadlineOffsets String?  @db.Text
  isActive        Boolean  @default(true)
  createdById     String?
  lastRunAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  logs ScheduledReminderLog[]

  @@index([churchId])
  @@index([ministryAdminId])
  @@index([campaignId])
  @@index([eventId])
  @@index([type])
  @@index([isActive])
  @@map("scheduled_reminders")
}

model ScheduledReminderLog {
  id             String   @id @default(cuid())
  reminderId     String
  userId         String?
  recipientEmail String?
  channel        String
  status         String
  scheduledFor   DateTime
  sentAt         DateTime?
  error          String?  @db.Text
  dedupeKey      String   @unique
  createdAt      DateTime @default(now())

  reminder ScheduledReminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  @@index([reminderId])
  @@index([userId])
  @@index([scheduledFor])
  @@index([status])
  @@map("scheduled_reminder_logs")
}

model AnnouncementView {
  id             String       @id @default(cuid())
  announcementId String
  userId         String
  viewedAt       DateTime     @default(now())

  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([announcementId])
  @@map("announcement_views")
}

model ResourceView {
  id         String   @id @default(cuid())
  resourceId String
  userId     String
  viewedAt   DateTime @default(now())

  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([resourceId, userId])
  @@index([resourceId])
  @@map("resource_views")
}

// ─── Cell / Fellowship Management ─────────────────────────────────────────────

model Cell {
  id              String   @id @default(cuid())
  churchId        String
  name            String
  zone            String?  // residential area / zone
  meetingDay      String?  // Monday, Tuesday, etc.
  meetingTime     String?  // e.g. "18:00"
  status          String   @default("active") // active | inactive
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  church          Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  members         CellMember[]
  meetings        CellMeeting[]
  campaigns       GivingCampaign[]
  donations       DonationTransaction[]

  @@index([churchId])
  @@index([status])
  @@map("cells")
}

model CellMember {
  id          String   @id @default(cuid())
  cellId      String
  userId      String
  joinedAt    DateTime @default(now())
  leftAt      DateTime?  // set when removed (soft delete)
  status      String   @default("active") // active | inactive | new_convert
  tags        String?  // JSON array e.g. ["New Member", "Leader-in-training"]
  isLeader    Boolean  @default(false)
  isAssistant Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cell        Cell     @relation(fields: [cellId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cellId, userId])
  // Enforce one leader and one assistant per cell using filtered logic in application layer
  @@index([cellId])
  @@index([userId])
  @@map("cell_members")
}

model CellMeeting {
  id          String   @id @default(cuid())
  cellId      String
  date        DateTime
  topic       String?
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cell        Cell     @relation(fields: [cellId], references: [id], onDelete: Cascade)
  attendance  CellAttendance[]

  @@index([cellId])
  @@index([date])
  @@map("cell_meetings")
}

model CellAttendance {
  id              String   @id @default(cuid())
  meetingId       String
  cellId          String
  userId          String?  // null if visitor
  status          String   @default("present") // present | absent | excused
  isVisitor       Boolean  @default(false)
  visitorName     String?
  visitorPhone    String?
  visitorEmail    String?
  isFirstTime     Boolean  @default(true) // first-time vs returning visitor
  invitedByUserId String?  // which cell member invited this visitor
  notes           String?
  createdAt       DateTime @default(now())

  meeting         CellMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user            User?       @relation(fields: [userId], references: [id])

  @@index([meetingId])
  @@index([cellId])
  @@index([userId])
  @@map("cell_attendance")
}

// ─── Church Public Profile ────────────────────────────────────────────────────

// ─── Push Notification Device Tokens ─────────────────────────────────────

model DeviceToken {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique  // FCM registration token
  platform   String   @default("web")  // web | android | ios
  userAgent  String?  // Browser user agent string
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("device_tokens")
}

// ─── Church Public Profile ────────────────────────────────────────────────────

model ChurchProfile {
  id                String   @id @default(cuid())
  ministryAdminId   String   @unique

  // Branding (requires church_website feature)
  logoUrl           String?
  bannerUrl         String?
  primaryColor      String?  @default("#d89b12")
  tagline           String?

  // About (requires church_website feature)
  aboutText         String?  @db.Text
  pastorName        String?
  pastorPhoto       String?
  pastorBio         String?  @db.Text
  visionText        String?
  missionText       String?

  // Service times JSON: [{name, day, time, location}]
  serviceTimes      String?  @db.Text

